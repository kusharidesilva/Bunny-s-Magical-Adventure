    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.7.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
